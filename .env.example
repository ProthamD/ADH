# AWS Bedrock Configuration (Strict Bedrock Mode)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# Cryptography & Security
ENCRYPTION_KEY=your_fernet_key_base64_here
HMAC_SECRET=your_hex_hmac_secret_here

# Gatekeeper Tuning
CONFIDENCE_THRESHOLD=0.75
MAX_FACTS_PER_ANSWER=2

# Escalation Target (Slack/Discord/Generic Webhook)
ESCALATION_WEBHOOK_URL=https://httpbin.org/post

# Demo & Environment Settings
DEMO_MODE=true
HOST=127.0.0.1
PORT=8000
